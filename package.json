{
  "name": "nitrobolt-desktop",
  "description": "A mod of TurboWarp with tons of new features, and a haven for developers who don't want to be restricted by \"compatibility\".",
  "version": "1.0.2",
  "packageManager": "pnpm@10.33.0",
  "license": "GPL-3.0",
  "type": "commonjs",
  "author": {
    "name": "Cubester",
    "email": "contact@nitrobolt.org"
  },
  "scripts": {
    "fetch": "node scripts/download-library-files.mjs && node scripts/download-packager.mjs && node scripts/prepare-extensions.mjs",
    "webpack:compile": "webpack",
    "webpack:watch": "webpack --watch",
    "webpack:prod": "cross-env NODE_ENV=production webpack",
    "electron:start": "electron src-main/entrypoint.js",
    "electron:linux": "./electron_build_fix_until_reboot.sh; electron src-main/entrypoint.js",
    "electron:package:dir": "electron-builder --dir",
    "translations:upload": "node scripts/upload-translations.mjs",
    "translations:download": "node scripts/download-translations.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.12.16",
    "@babel/preset-react": "^7.13.13",
    "@electron/fuses": "^2.1.2",
    "@nitro-bolt/extensions": "github:Nitro-Bolt/extensions#master",
    "@transifex/api": "4.3.0",
    "@turbowarp/extensions": "github:TurboWarp/extensions#master",
    "autoprefixer": "^9.8.8",
    "babel-loader": "^8.4.1",
    "copy-webpack-plugin": "^6.4.1",
    "cross-env": "^10.1.0",
    "css-loader": "^1.0.1",
    "electron": "^43.8.4",
    "electron-builder": "^26.18.0",
    "file-loader": "^6.2.0",
    "monaco-editor-webpack-plugin": "^4.2.0",
    "postcss": "^8.4.13",
    "postcss-import": "^14.0.0",
    "postcss-loader": "^4.2.0",
    "postcss-simple-vars": "^6.0.3",
    "scratch-gui": "github:Nitro-Bolt/scratch-gui#develop",
    "scratch-render-fonts": "github:TurboWarp/scratch-render-fonts#master",
    "style-loader": "^0.23.0",
    "url-loader": "^4.1.1",
    "webpack": "4.47.0",
    "webpack-cli": "^4.10.0"
  },
  "overrides": {
    "webpack@4.47.0": {
      "terser-webpack-plugin": "^4.2.3"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "electron-winstaller",
      "scratch-gui",
      "scratch-l10n"
    ]
  },
  "homepage": "https://desktop.nitrobolt.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nitro-Bolt/desktop.git"
  },
  "bugs": {
    "url": "https://github.com/Nitro-Bolt/desktop/issues",
    "email": "contact@nitrobolt.org"
  },
  "main": "./src-main/entrypoint.js",
  "desktopName": "org.nitrobolt.desktop",
  "build": {
    "appId": "org.nitrobolt.desktop",
    "productName": "NitroBolt",
    "files": [
      "node_modules/**/*",
      "src-main/**/*",
      "src-preload/**/*",
      "src-renderer/**/*",
      "dist-renderer-webpack/**/*",
      "dist-library-files/**/*",
      "dist-extensions/**/*"
    ],
    "extraResources": [
      {
        "from": "art/icon.png",
        "to": "icon.png"
      },
      {
        "from": "art/icon.svg",
        "to": "icon.svg"
      }
    ],
    "win": {
      "artifactName": "${productName}-Windows-${arch}-${version}.${ext}",
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        },
        {
          "target": "portable",
          "arch": "x64"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "deleteAppDataOnUninstall": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Windows-Installer-${arch}-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Windows-Portable-${arch}-${version}.${ext}"
    },
    "appx": {
      "artifactName": "${productName}-Windows-Store-${arch}-${version}.${ext}",
      "applicationId": "NitroBolt",
      "displayName": "NitroBolt",
      "identityName": "Cubester.NitroBolt",
      "publisher": "CN=54F4F60F-5369-41E6-BB97-D1795FE27384",
      "publisherDisplayName": "Cubester",
      "backgroundColor": "#ff512b",
      "showNameOnTiles": true
    },
    "mac": {
      "artifactName": "${productName}-MacOS-${arch}-${version}.${ext}",
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "darkModeSupport": true,
      "gatekeeperAssess": false,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSMultipleInstancesProhibited": true,
        "NSCameraUsageDescription": "This app requires camera access when using the video sensing or face sensing blocks.",
        "NSMicrophoneUsageDescription": "This app requires microphone access when recording sounds or detecting loudness."
      },
      "target": [
        {
          "arch": "universal",
          "target": "dmg"
        }
      ]
    },
    "linux": {
      "executableName": "nitrobolt-desktop",
      "artifactName": "${productName}-Linux-Installer-${arch}-${version}.${ext}",
      "maintainer": "Cubester <contact@nitrobolt.org>",
      "icon": "./build/",
      "synopsis": "Mod of TurboWarp with tons of powerful new features.",
      "description": "NitroBolt is a mod of TurboWarp with tons of new features, and a haven for developers who don't want to be restricted by \"compatibility\".",
      "category": "Development",
      "desktop": {
        "entry": {
          "StartupWMClass": "nitrobolt-desktop",
          "Keywords": "scratch; turbowarp;"
        }
      },
      "extraFiles": [
        "linux-files"
      ],
      "target": [
        {
          "target": "deb"
        },
        {
          "target": "appimage"
        },
        {
          "target": "rpm"
        },
        {
          "target": "tar.gz"
        }
      ]
    },
    "appImage": {
      "license": null
    },
    "rpm": {
      "artifactName": "${productName}-Linux-Installer-${arch}-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "sb3",
        "name": "Scratch 3 Project",
        "description": "Scratch 3 Project",
        "role": "Editor",
        "mimeType": "application/x.scratch.sb3"
      },
      {
        "ext": "sb2",
        "name": "Scratch 2 Project",
        "description": "Scratch 2 Project",
        "role": "Editor",
        "mimeType": "application/x.scratch.sb2"
      },
      {
        "ext": "sb",
        "name": "Scratch 1 Project",
        "description": "Scratch 1 Project",
        "role": "Editor",
        "mimeType": "application/x.scratch.sb"
      }
    ]
  },
  "private": true
}
